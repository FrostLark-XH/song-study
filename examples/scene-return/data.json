      "brief": {
        "premise": "叙述者推窗看雨停，却仍停留在一个人的声音里。",
        "emotional_arc": "从外界静下来，到容许自己停留，最后接受独处。",
        "evidence_basis": "lyrics_only"
      },
      "system": {
        "concept": "以窗外转晴和室内等待组织一段安静的告别。",
        "palette_logic": "暖纸色表示室内停留；末段转灰绿，表示接受而非爆发。",
        "typography_logic": "衬线的细节保留亲近的书页感；不作巨大呼喊。",
        "composition_logic": "窗与文字共享留白；最后镜头靠近茶杯，窗的位置仍可识别。",
        "motif_logic": "同一扇窗由闭到开，雨丝淡出；同一个茶杯留在末段，表示允许停留。",
        "avoid": [
          "霓虹",
          "强冲击倾斜",
          "副歌式爆亮"
        ]
      },
      "timeline": [
        {
          "id": "outside-to-memory",
          "line_ids": [
            "window-01",
            "window-02",
            "window-03"
          ],
          "state": "外部安静，记忆仍在",
          "visual_shift": "开场留白后转向室内凝视",
          "reason": "雨停与声音残留构成外部/内部的对照。"
        },
        {
          "id": "acceptance",
          "line_ids": [
            "window-04",
            "window-05",
            "window-06"
          ],
          "state": "容许停留，接受独处",
          "visual_shift": "保持衬线与左重心，底色轻转灰绿",
          "reason": "茶凉是缓慢的时间，末句是安静确认。"
        }
      ]
    }
